{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archlens/analysis.schema.json",
  "title": "Archlens Architecture Analysis",
  "description": "The analysis is the artifact. Diagrams and prose are both rendered from it, so a fact is written once and cannot disagree with itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system",
    "components",
    "relations",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence. What the system is for, not how it works."
        },
        "domain": {
          "enum": [
            "software",
            "document"
          ],
          "default": "software",
          "description": "What is being analysed. 'document' relabels the legend for prose subjects such as a paper or a specification, and takes evidence from doc_refs rather than from a repository."
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "description": "Override the legend wording for any of the seven diagram families. Overrides the domain default.",
          "properties": {
            "frontend": {
              "type": "string",
              "maxLength": 24,
              "description": "cli, ui"
            },
            "backend": {
              "type": "string",
              "maxLength": 24,
              "description": "api, service, worker, library, engine, workflow, broker"
            },
            "database": {
              "type": "string",
              "maxLength": 24,
              "description": "store, file-store, cache, schema, config"
            },
            "messagebus": {
              "type": "string",
              "maxLength": 24,
              "description": "queue"
            },
            "security": {
              "type": "string",
              "maxLength": 24,
              "description": "sandbox, gateway"
            },
            "cloud": {
              "type": "string",
              "maxLength": 24
            },
            "external": {
              "type": "string",
              "maxLength": 24,
              "description": "model-provider, external-service, third-party"
            }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "revision"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?/?$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          }
        },
        "sources": {
          "type": "array",
          "description": "What the analysis was read from. An analysis with no sources is an opinion.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "code",
                  "document",
                  "conversation",
                  "external"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "description": "Optional. Gives the compiler a rank order; without it rank is derived from the relation graph.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "order"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "description": "A boundary must make a claim. A box that only groups is decoration.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "contains",
          "claim"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "trust",
              "process",
              "network",
              "deployment",
              "licence",
              "ownership"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "description": "What is true of everything inside, and not outside."
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "responsibility"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "$ref": "#/$defs/componentKind"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence, active voice. If it needs 'and', it may be two components."
          },
          "detail": {
            "type": "string",
            "maxLength": 28,
            "description": "Optional short qualifier rendered under the name. Kept short because a diagram has no room."
          },
          "layer": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": [
              "built",
              "partial",
              "planned"
            ],
            "default": "built"
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          },
          "doc_refs": {
            "$ref": "#/$defs/docRefList"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "mechanism",
          "summary"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "mechanism": {
            "$ref": "#/$defs/mechanism"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 34,
            "description": "The edge label. Short enough to survive a diagram."
          },
          "what_crosses": {
            "type": "string",
            "description": "The data or control that actually moves. The most valuable field in the model and the one prose usually omits."
          },
          "synchronous": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "built",
              "partial",
              "planned"
            ],
            "default": "built"
          },
          "crosses": {
            "$ref": "#/$defs/id",
            "description": "Boundary id this relation crosses, if any."
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "description": "One diagram per question. A diagram without a question is a picture of a codebase. A question is an architecture unless its shape says otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "ask",
          "involves"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "ask": {
            "type": "string",
            "minLength": 1,
            "description": "The question in plain words, ending in a question mark."
          },
          "shape": {
            "enum": [
              "architecture",
              "sequence"
            ],
            "default": "architecture",
            "description": "What the diagram is. An architecture shows the parts and what joins them; a sequence shows one exchange in order, and needs `steps`. Choose by the question: \"what are the parts\" is an architecture, \"what happens when\" is a sequence."
          },
          "context": {
            "type": "string",
            "maxLength": 1200,
            "description": "Prose. What the question is about and why a reader should care, before the answer means anything. Rendered under the title, above the diagram."
          },
          "answer": {
            "type": "string",
            "description": "The short answer. Becomes the diagram's lead card."
          },
          "involves": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "Sequence only. The exchanges in order, top to bottom. Each runs along a relation the analysis declares — forwards for a call, in either direction for a return — so a sequence can never show a message the model does not have. `involves` gives the participant order, left to right.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "$ref": "#/$defs/id"
                },
                "to": {
                  "$ref": "#/$defs/id"
                },
                "says": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 34,
                  "description": "The message label. Defaults to the relation's summary; required for a return, which has no relation of its own."
                },
                "kind": {
                  "enum": [
                    "call",
                    "return",
                    "async"
                  ],
                  "default": "call",
                  "description": "call is a solid arrow; return is the quiet reply along the same relation; async is dashed, for a message the sender does not wait on."
                },
                "phase": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "description": "Consecutive steps sharing a phase are bracketed together and labelled with it."
                },
                "note": {
                  "type": "string",
                  "description": "What this message carries, when it differs from the relation's what_crosses. Shown in the document, not on the diagram."
                }
              }
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Components the answer turns on. Rendered with emphasis."
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Fact ids to render as cards beside the diagram."
          },
          "omits": {
            "type": "string",
            "description": "What this view deliberately leaves out, and why."
          },
          "narrative": {
            "type": "string",
            "maxLength": 6000,
            "description": "The long read, for a junior developer or junior researcher meeting the system for the first time. Walk the diagram in order and say what each step means. Blank lines become paragraphs. Rendered below the diagram, never on it."
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "description": "Claims that belong to the architecture rather than to any one component.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "claim"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "doctrine",
              "guarantee",
              "constraint",
              "tradeoff",
              "risk"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "because": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          },
          "rule": {
            "description": "Constraint only. A machine-checkable form of the claim, about which parts may reach which. Checked against the analysis's own relations by validate, and against imports in the cited code by enforce. Ids may name a component or a boundary; a boundary stands for all its members.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "from",
                  "to"
                ],
                "properties": {
                  "kind": {
                    "const": "no-relation"
                  },
                  "from": {
                    "$ref": "#/$defs/id",
                    "description": "Nothing in here…"
                  },
                  "to": {
                    "$ref": "#/$defs/id",
                    "description": "…reaches anything in here."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "to",
                  "via"
                ],
                "properties": {
                  "kind": {
                    "const": "only-via"
                  },
                  "to": {
                    "$ref": "#/$defs/id",
                    "description": "Everything that reaches this…"
                  },
                  "via": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "description": "…comes from one of these, or from inside it."
                  }
                }
              }
            ]
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "description": "Terms a newcomer will not know. Each question renders only the terms it uses.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "One or two sentences. Assume no prior exposure to this system."
          },
          "also": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Abbreviations or alternate spellings that should match this term."
          }
        }
      }
    },
    "$defs": {}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "componentKind": {
      "description": "Richer than a renderer needs, on purpose. The compiler narrows it; the analysis keeps the distinction.",
      "enum": [
        "cli",
        "ui",
        "api",
        "service",
        "worker",
        "library",
        "engine",
        "store",
        "file-store",
        "queue",
        "cache",
        "sandbox",
        "gateway",
        "broker",
        "model-provider",
        "external-service",
        "third-party",
        "workflow",
        "schema",
        "config"
      ]
    },
    "mechanism": {
      "enum": [
        "in-process call",
        "http",
        "https",
        "grpc",
        "stdio",
        "spawn",
        "file",
        "database",
        "queue",
        "event",
        "signal",
        "manual"
      ]
    },
    "evidenceList": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Repository-relative path. Verified by the renderer when a repository revision is given."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          }
        }
      }
    },
    "docRefList": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    }
  }
}
